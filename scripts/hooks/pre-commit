#!/usr/bin/env bash
# Solo-dev pre-commit: cheapest gate that catches real mistakes.
# ~1s warm: format + shell syntax + cached whitespace. Heavier lanes (standard,
# ci-verify) run on push or explicitly — not on every commit — so you don't
# wait on builds while iterating. Bypass with `git commit --no-verify` when
# mid-edit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

cargo fmt --all -- --check
bash -n scripts/test.sh scripts/verify_cli.sh
# --check only bleeds on staged changes so you get whitespace diagnostics
# without scanning the whole repo.
git diff --cached --check
