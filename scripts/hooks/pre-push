#!/usr/bin/env bash
# Solo-dev pre-push: minimal gate, maximal signal.
# Default is `quick` (~2s warm, lib only) so pushes stay snappy and you
# don't re-verify identical bytes. The receipt cache (git-wizard) skips
# duplicate work when `quick`/`standard` already passed on these bytes.
# Tight loop: `bash scripts/test.sh fast <filter>` (<1s). Pre-commit gate:
# `bash scripts/test.sh standard` (~6s). Stronger push: set
# `CIVIC_DYNASTY_PRE_PUSH=standard` to enforce docs + CLI smoke on push.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

gate=${CIVIC_DYNASTY_PRE_PUSH:-quick}
python_command=
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1; then
    python_command=$candidate
    break
  fi
done
if [[ -n "$python_command" ]] && "$python_command" scripts/validation_receipt.py check "$gate"; then
  printf 'pre-push: current repository content already passed %s-or-broader validation; skipping duplicate gate\n' "$gate"
  exit 0
fi
bash scripts/test.sh "$gate"
