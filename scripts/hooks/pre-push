#!/usr/bin/env bash
# Local pre-push gate: fast verification for solo local work.
# Keeps pushes snappy — runs the quick library gate only. Use
# `bash scripts/test.sh standard` manually before a risky push,
# or set CIVIC_DYNASTY_PRE_PUSH=standard to enforce the fuller gate.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

gate=${CIVIC_DYNASTY_PRE_PUSH:-quick}
bash scripts/test.sh "$gate"
